# Orbit web app configuration. Copy to apps/web/.env.local for local development
# and set the same variables in Vercel. Never commit real values.

# Network. Orbit is testnet-only; any other value fails at startup.
NEXT_PUBLIC_NEAR_NETWORK=testnet

# Account of the deployed Orbit factory (launch registry). Without it, the app
# runs but shows no launches and cannot submit new ones.
NEXT_PUBLIC_ORBIT_FACTORY=

# Optional comma-separated HTTPS RPC endpoints, tried in order.
# Default: https://test.rpc.fastnear.com,https://near-testnet.drpc.org
NEXT_PUBLIC_NEAR_RPC_URLS=

# Optional HTTPS IPFS gateway used to display ipfs:// media.
# Default: https://gateway.pinata.cloud/ipfs
NEXT_PUBLIC_IPFS_GATEWAY=

# Server-only. Pinata JWT used to sign short-lived browser upload URLs.
# Leave empty to disable uploads (creators can still paste ipfs:// or https:// URLs).
PINATA_JWT=
